# Safe local-development examples only. Copy to .env and never commit real values.
SPEAKFLOW_ENV=development
SPEAKFLOW_DATA_DIR=./data
SPEAKFLOW_DATABASE_URL=sqlite:///./data/speakflowai-dev.db
SPEAKFLOW_LOG_LEVEL=INFO

# Required for real voice sessions. Keep this server-side only.
# OPENAI_API_KEY=
SPEAKFLOW_REALTIME_MODEL=gpt-realtime-2.1-mini
SPEAKFLOW_REALTIME_MAX_OUTPUT_TOKENS=350
SPEAKFLOW_REALTIME_SESSION_LIMIT_MINUTES=15

# Optional public API origin used by the web/mobile bundle. Never place secrets here.
# VITE_API_BASE_URL=https://api.example.com
