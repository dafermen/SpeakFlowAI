{
  "name": "@speakflow/docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vitepress build .. && node scripts/check-bundle.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "dev": "vitepress build .. && vite preview .. --host 127.0.0.1 --port 5174 --strictPort",
    "format": "prettier --check . ../.vitepress --ignore-path ../.gitignore",
    "lint": "eslint .",
    "preview": "vitepress preview ..",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mermaid": "^11.16.0",
    "vitepress": "^1.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "6.4.3",
    "vitest": "^4.1.10"
  }
}
