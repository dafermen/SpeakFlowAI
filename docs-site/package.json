{
  "name": "@speakflow/docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vitepress build .. && node scripts/check-bundle.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "dev": "vitepress build .. && vite preview .. --host 127.0.0.1 --port 5174 --strictPort",
    "format": "prettier --check . ../.vitepress --ignore-path ../.gitignore",
    "lint": "eslint .",
    "preview": "vitepress preview ..",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "mermaid": "^12.0.0",
    "vitepress": "^1.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "8.3.1",
    "vitest": "^5.0.2"
  }
}
