{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speakflowai.local/schemas/learning-mode.v1.json",
  "title": "SpeakFlowAI learning mode",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "titleKey", "summaryKey", "icon", "recommended"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^mode\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "titleKey": {
      "type": "string",
      "pattern": "^mode\\.[a-zA-Z0-9.]+$"
    },
    "summaryKey": {
      "type": "string",
      "pattern": "^mode\\.[a-zA-Z0-9.]+$"
    },
    "icon": {
      "enum": ["conversation", "workplace", "support", "interview"]
    },
    "recommended": { "type": "boolean" }
  }
}
