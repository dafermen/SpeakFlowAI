{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speakflowai.local/schemas/scenario.v1.json",
  "title": "SpeakFlowAI scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "modeId",
    "status",
    "difficulty",
    "durationMinutes",
    "titleKey",
    "summaryKey",
    "objectiveKey",
    "roles",
    "promptTemplateId",
    "tags"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^scenario\\.[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$"
    },
    "modeId": {
      "type": "string",
      "pattern": "^mode\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "status": {
      "enum": ["draft", "published", "deprecated"]
    },
    "difficulty": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["a2", "b1", "b2", "c1"]
      }
    },
    "durationMinutes": {
      "type": "integer",
      "minimum": 3,
      "maximum": 30
    },
    "titleKey": {
      "$ref": "#/$defs/contentKey"
    },
    "summaryKey": {
      "$ref": "#/$defs/contentKey"
    },
    "objectiveKey": {
      "$ref": "#/$defs/contentKey"
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["learner", "tutor"],
      "properties": {
        "learner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "tutor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "promptTemplateId": {
      "type": "string",
      "pattern": "^prompt\\.[a-z0-9.-]+\\.v[1-9][0-9]*$"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 12,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  },
  "$defs": {
    "contentKey": {
      "type": "string",
      "pattern": "^scenario\\.[a-zA-Z0-9.]+$"
    }
  }
}
