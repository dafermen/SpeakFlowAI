{
  "name": "speakflow-ai",
  "version": "1.0.0",
  "private": true,
  "description": "AI voice companion for practical English speaking.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "vue": "^3.5.40"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @speakflow/web --filter @speakflow/docs dev",
    "dev:docs": "pnpm --filter @speakflow/docs dev",
    "dev:web": "pnpm --filter @speakflow/web dev",
    "format": "pnpm -r --if-present format",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  }
}
